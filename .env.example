# Un seul .env à la racine du projet — lu à la fois par Vite (au build)
# et par l'API Express (au runtime), même si son process tourne avec
# un cwd différent (api/).

PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# Chemin relatif : le frontend et l'API sont servis par le même processus,
# donc même origine, pas besoin de domaine complet ni de CORS.
VITE_API_URL=/api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jeuxbibliques
DB_USERNAME=jeuxbibliques
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=*
